rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'citizen';
      allow update: if signedIn() &&
        ((request.auth.uid == uid && request.resource.data.role == resource.data.role)
         || isAdmin());
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supporters']));
      allow delete: if isAdmin();

      match /updates/{updateId} {
        allow read: if signedIn();
        allow create: if isAdmin() || (signedIn() &&
          get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid);
      }
    }
  }
}
